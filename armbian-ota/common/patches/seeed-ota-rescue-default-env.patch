+	"ota_rescue_boot_fit=setenv boot_fit_part recovery; env set bootargs \"${bootargs} armbian.bootdev=${devtype} armbian.bootdevnum=${devnum} armbian.ota_role=recovery\"; boot_fit\0" \
+	"ota_rescue_boot=run ota_rescue_boot_fs || run ota_rescue_boot_fit || run distro_bootcmd\0"
+#endif
+
 #define CONFIG_EXTRA_ENV_SETTINGS \
 	BOOTENV_SHARED_MTD	\
 	ENV_MEM_LAYOUT_SETTINGS \
@@ -91,7 +123,11 @@
 	"partitions=" PARTS_RKIMG \
 	ROCKCHIP_DEVICE_SETTINGS \
 	RKIMG_DET_BOOTDEV \
+	OTA_RESCUE_ENV_SETTINGS \
 	BOOTENV
+
+#undef CONFIG_BOOTCOMMAND
+#define CONFIG_BOOTCOMMAND "run ota_rescue_boot"
 #endif
 
 /* rockchip ohci host driver */
--- a/cmd/booti.c
+++ b/cmd/booti.c
@@ -134,6 +134,20 @@
 {
 	int ret;
 
+#ifdef CONFIG_FIT_SIGNATURE
+	/*
+	 * Seeed secure-boot lockdown: verified builds launch kernels only
+	 * through FIT configurations checked against the required key in
+	 * the control DTB (boot_fit / bootm). Raw ARM64 Image execution is
+	 * the unverified boot.scr / rescue-fs path, so refuse it no matter
+	 * which environment script -- possibly one from a foreign image's
+	 * unsigned env blob -- asked for it. DISTRO_DEFAULTS selects this
+	 * command on ARM64, so it cannot be Kconfig-disabled instead.
+	 */
+	printf("booti: raw Image boot is disabled on verified-boot builds\n");
+	return CMD_RET_FAILURE;
+#endif
+
 	/* Consume 'booti' */
 	argc--; argv++;
 
--- a/cmd/bootm.c
+++ b/cmd/bootm.c
@@ -92,4 +92,11 @@
 int do_bootm(cmd_tbl_t *cmdtp, int flag, int argc, char * const argv[])
 {
+#ifndef CONFIG_FIT_SIGNATURE
+	/* Seeed plain-build lockdown: plain boards boot from ext4 assets
+	 * only; mirror of the booti guard on verified builds. */
+	printf("bootm: FIT boot is disabled on plain builds\n");
+	return CMD_RET_FAILURE;
+#endif
+
 #ifdef CONFIG_NEEDS_MANUAL_RELOC
 	static int relocated = 0;

--- a/cmd/bootfit.c
+++ b/cmd/bootfit.c
@@ -59,6 +59,13 @@
 static int do_boot_fit(cmd_tbl_t *cmdtp, int flag, int argc, char *const argv[])
 {
+#ifndef CONFIG_FIT_SIGNATURE
+	/* Seeed plain-build lockdown: raw-FIT layout entry (also via
+	 * "bootm <fit_addr>"), never needed on plain boards. */
+	printf("boot_fit: raw FIT boot is disabled on plain builds\n");
+	return CMD_RET_FAILURE;
+#endif
+
 	char *bootm_args[1];
 	char fit_addr[12];
 	ulong size;
 	void *fit;
