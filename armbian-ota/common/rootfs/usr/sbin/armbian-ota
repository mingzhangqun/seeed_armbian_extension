#!/bin/bash

OTA_RUNTIME_DIR="/usr/share/armbian-ota"
[ -f "${OTA_RUNTIME_DIR}/common.sh" ] || {
    echo "ERROR: OTA runtime libraries not found at ${OTA_RUNTIME_DIR}" >&2
    exit 1
}
export OTA_RUNTIME_DIR
. "${OTA_RUNTIME_DIR}/common.sh"

HAS_BACKEND=""
for _mode in ab recovery; do
    if [ -f "${OTA_RUNTIME_DIR}/${_mode}/backend.sh" ]; then
        . "${OTA_RUNTIME_DIR}/${_mode}/backend.sh"
        HAS_BACKEND="${_mode}"
        break
    fi
done

require_mode_backend() {
    local mode="$1"

    [ "${HAS_BACKEND}" = "${mode}" ] || \
        error_exit "${mode} OTA backend is not installed on this firmware (have: ${HAS_BACKEND:-none})"
}

detect_device_encryption() {
    local mode="$1" partlabel dev

    if [ "${mode}" = "ab" ]; then
        # Encrypted A/B: ext4 label is inside the LUKS container, so probe by GPT PARTLABEL.
        # A cloned A/B disk attached as a second device carries duplicate PARTLABELs, so a
        # system-wide first blkid match may probe the wrong disk; anchor to the U-Boot boot
        # disk when its cmdline tokens are present, keep first-match otherwise.
        local disk
        disk="$(ab_boot_disk || true)"
        for partlabel in rootfs_a rootfs_b; do
            dev="$(ab_blkid_first_on_disk "PARTLABEL=${partlabel}" "${disk}" 2>/dev/null || true)"
            [ -n "${dev}" ] || continue
            [ "$(blkid -o value -s TYPE "${dev}" 2>/dev/null || true)" = "crypto_LUKS" ] && { echo "yes"; return 0; }
        done
        echo "no"
    else
        # Recovery: answer from the root filesystem this system actually runs
        # from. A system-wide crypto_LUKS scan would let a LUKS partition on an
        # attached second disk answer for the boot device and reject valid
        # plain packages (and vice versa).
        local root_src
        root_src="$(findmnt -n -o SOURCE /media/root-ro 2>/dev/null || true)"
        [ -n "${root_src}" ] || root_src="$(findmnt -n -o SOURCE / 2>/dev/null || true)"
        [ -n "${root_src}" ] || root_src="$(df / | awk 'NR==2 {print $1}')"
        case "${root_src}" in
            /dev/mapper/*|/dev/dm-*) echo "yes" ;;
            *) [ "$(blkid -o value -s TYPE "${root_src}" 2>/dev/null || true)" = "crypto_LUKS" ] && echo "yes" || echo "no" ;;
        esac
    fi
}

check_ota_pkg() {
    local package_path="$1" package_encrypted device_encrypted

    [ -f "${package_path}" ] || error_exit "OTA package not found: ${package_path}"
    load_package_env_metadata "${package_path}" || error_exit "OTA package metadata missing package.env"

    OTA_CLI_MODE="$(package_env_get_value "OTA_MODE" || true)"
    case "${OTA_CLI_MODE}" in
        ab|recovery) ;;
        *) error_exit "Invalid OTA_MODE in package metadata: ${OTA_CLI_MODE:-<empty>} (expected ab or recovery)" ;;
    esac

    package_encrypted="$(package_env_get_value "OTA_ENCRYPTED" || true)"
    case "${package_encrypted:-no}" in
        yes|no) ;;
        *) error_exit "Invalid OTA_ENCRYPTED in package metadata: ${package_encrypted} (expected yes or no)" ;;
    esac

    device_encrypted="$(detect_device_encryption "${OTA_CLI_MODE}")"
    [ "${package_encrypted}" = "${device_encrypted}" ] ||
        error_exit "OTA package encryption mismatch: package=${package_encrypted}, device=${device_encrypted}"
}

call_mode_action() {
    local mode="$1" action="$2" package="${3:-}"
    require_mode_backend "${mode}"
    case "${action}" in
        start)
            if [ "${mode}" = "recovery" ]; then
                recovery_start_ota "${package}" "${OTA_CLI_FORCE:-}" "${OTA_CLI_NO_BACKUP:-}"
            else
                "${mode}_start_ota" "${package}"
            fi
            ;;
        status|mark-success|rollback) "${mode}_${action//-/_}" ;;
        *) error_exit "Unsupported action: ${action}" ;;
    esac
}

dispatch_by_state_mode() {
    local action="$1" current_mode
    current_mode="$(state_get OTA_MODE)"

    case "${current_mode}" in
        ab|recovery) call_mode_action "${current_mode}" "${action}"; return ;;
    esac

    [ "${action}" = "status" ] || \
        error_exit "No OTA mode recorded in ${OTA_STATE_FILE}. Start an OTA first."
    echo "=== Armbian OTA Status ==="
    echo "Mode: unknown"
    echo "Status: $(state_get STATUS)"
}

case "${1:-}" in
    start)
        shift
        ensure_root
        OTA_CLI_FORCE=""
        OTA_CLI_NO_BACKUP=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --force)     OTA_CLI_FORCE="yes"; shift ;;
                --no-backup) OTA_CLI_NO_BACKUP="yes"; shift ;;
                -*)          error_exit "Unknown option: $1 (supported: --force, --no-backup)" ;;
                *)           break ;;
            esac
        done
        [ $# -eq 1 ] || error_exit "start requires exactly one argument: the OTA package path (options: --force, --no-backup)"
        OTA_CLI_PACKAGE="$1"
        check_ota_pkg "${OTA_CLI_PACKAGE}"
        call_mode_action "${OTA_CLI_MODE}" "start" "${OTA_CLI_PACKAGE}"
        ;;
    status)
        state_init
        dispatch_by_state_mode "status"
        ;;
    switch-slot)
        shift
        ensure_root
        require_mode_backend "ab"
        ab_switch_slot "${1:-}"
        ;;
    
    # internal
    mark-success)
        ensure_root
        state_init
        dispatch_by_state_mode "mark-success"
        ;;
    rollback)
        ensure_root
        state_init
        dispatch_by_state_mode "rollback"
        ;;
    *)
        cat <<'EOF'
Usage:
  armbian-ota start [--force] [--no-backup] <ota-package.tar.gz>
  armbian-ota status
  armbian-ota switch-slot [a|b]

Options (recovery mode):
  --force      bypass the INSTALLED_ID duplicate check (reinstall repair)
  --no-backup  skip the lazy last-good backup creation for this transaction
EOF
        exit 1
        ;;
esac
