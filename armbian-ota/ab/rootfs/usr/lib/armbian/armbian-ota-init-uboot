#!/bin/bash
#
# Initialize u-boot environment for AB partition OTA
# This script modifies u-boot environment to support A/B slot boot selection
# Supports NVMe, SD card (mmc), and eMMC (mmc) storage devices
#

set -e

OTA_RUNTIME_DIR="/usr/share/armbian-ota"
AB_ENV_LIB="${OTA_RUNTIME_DIR}/ab/env.sh"
[ -r "${AB_ENV_LIB}" ] || {
    echo "ERROR: A/B U-Boot environment helper not found: ${AB_ENV_LIB}" >&2
    exit 1
}
. "${AB_ENV_LIB}"

# Env geometry (OTA_FW_ENV_*) and fw_env_* helpers come from fwenv.sh,
# sourced via ab/env.sh.
readonly AB_STATE_DIR="/var/lib/armbian-ota"
readonly AB_UBOOT_INITIALIZED_FILE="${AB_STATE_DIR}/uboot_initialized"

# Logging
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

log_info() {
    log "INFO: $@"
}

log_error() {
    log "ERROR: $@" >&2
}

# Fatal: log every message, then exit.
fail() {
    local msg
    for msg in "$@"; do
        log_error "${msg}"
    done
    exit 1
}

# /dev/nvme0n1p1 -> 1
get_partition_number_from_dev() {
    local dev="$1"
    local base
    base="$(basename "${dev}")"

    # /dev/mmcblk0p1 or /dev/nvme0n1p1 -> 1
    if [[ "${base}" =~ p([0-9]+)$ ]]; then
        echo "${BASH_REMATCH[1]}"
        return 0
    fi

    return 1
}

get_uboot_bootdev_from_part() {
    local dev="$1"
    local base
    base="$(basename "${dev}")"

    # /dev/mmcblk1p1 -> mmc 1
    if [[ "${base}" =~ ^mmcblk([0-9]+)p[0-9]+$ ]]; then
        echo "mmc ${BASH_REMATCH[1]}"
        return 0
    fi

    # /dev/nvme0n1p1 -> nvme 0
    if [[ "${base}" =~ ^nvme([0-9]+)n[0-9]+p[0-9]+$ ]]; then
        echo "nvme ${BASH_REMATCH[1]}"
        return 0
    fi

    return 1
}

# A/B partition and boot media discovery.
detect_ab_boot_partitions() {
    boot_a_dev="$(ab_get_part_by_label "${BOOT_A_LABEL}")"
    boot_b_dev="$(ab_get_part_by_label "${BOOT_B_LABEL}")"
    if [ -z "${boot_a_dev}" ] || [ -z "${boot_b_dev}" ]; then
        fail "Cannot find one or more A/B boot partitions by label" \
             "boot_a=${boot_a_dev:-<none>} boot_b=${boot_b_dev:-<none>}"
    fi
}

detect_ab_root_partitions() {
    root_a_dev="$(ab_get_part_by_label "${ROOT_A_LABEL}")"
    root_b_dev="$(ab_get_part_by_label "${ROOT_B_LABEL}")"
    if [ -z "${root_a_dev}" ] || [ -z "${root_b_dev}" ]; then
        fail "Cannot find one or more A/B root partitions by label" \
             "root_a=${root_a_dev:-<none>} root_b=${root_b_dev:-<none>}"
    fi

    # Use detected partition mapping to support custom layouts, such as ones
    # with BIOS, EFI, or security partitions before the A/B slots.
    BOOT_A_PART=$(get_partition_number_from_dev "${boot_a_dev}" || true)
    BOOT_B_PART=$(get_partition_number_from_dev "${boot_b_dev}" || true)
    ROOT_A_PART=$(get_partition_number_from_dev "${root_a_dev}" || true)
    ROOT_B_PART=$(get_partition_number_from_dev "${root_b_dev}" || true)

    if [ -z "${BOOT_A_PART}" ] || [ -z "${BOOT_B_PART}" ] || [ -z "${ROOT_A_PART}" ] || [ -z "${ROOT_B_PART}" ]; then
        fail "Failed to parse one or more partition numbers from device names" \
             "boot_a=${boot_a_dev} boot_b=${boot_b_dev} root_a=${root_a_dev} root_b=${root_b_dev}"
    fi
}

detect_ab_boot_configuration() {
    # Prefer U-Boot's own boot-device report from the kernel command line: the
    # boot script appends armbian.bootdev/armbian.bootdevnum using U-Boot's
    # device numbering, which is exactly what ab_select_boot_part compares
    # against. Linux device names follow the kernel DT alias order, which does
    # not match U-Boot's numbering on every platform (rk3572: kernel and
    # U-Boot DTs order the mmc aliases differently, so Linux mmcblk0 is U-Boot
    # mmc1) - deriving from the name pins the wrong device there and every
    # slot switch dies in ab_select_boot_part's mismatch fallback.
    BOOT_DEVTYPE="$(fw_env_cmdline_value armbian.bootdev)"
    BOOT_DEVNUM="$(fw_env_cmdline_value armbian.bootdevnum)"
    if [ -z "${BOOT_DEVTYPE}" ] || [ -z "${BOOT_DEVNUM}" ]; then
        read -r BOOT_DEVTYPE BOOT_DEVNUM <<< "$(get_uboot_bootdev_from_part "${boot_a_dev}" || true)"
    fi
    if [ -z "${BOOT_DEVTYPE}" ] || [ -z "${BOOT_DEVNUM}" ]; then
        fail "Unsupported boot_a device for U-Boot bootcmd generation: ${boot_a_dev}"
    fi

    boot_a_uuid="$(ab_get_uuid_by_label "${BOOT_A_LABEL}")"
    boot_b_uuid="$(ab_get_uuid_by_label "${BOOT_B_LABEL}")"
    root_a_uuid="$(ab_get_uuid_by_dev "${root_a_dev}")"
    root_b_uuid="$(ab_get_uuid_by_dev "${root_b_dev}")"
    boot_a_fstype="$(ab_get_fstype_by_dev "${boot_a_dev}")"
    boot_b_fstype="$(ab_get_fstype_by_dev "${boot_b_dev}")"
    if [ -z "${boot_a_fstype}" ] && [ -z "${boot_b_fstype}" ]; then
        AB_BOOT_MODE="raw-fit"
    elif [ -n "${boot_a_fstype}" ] && [ -n "${boot_b_fstype}" ]; then
        AB_BOOT_MODE="filesystem"
    else
        fail "A/B boot partitions use inconsistent formats: boot_a=${boot_a_fstype:-<raw>} boot_b=${boot_b_fstype:-<raw>}"
    fi
    CURRENT_SLOT="$(ab_get_current_root_slot || echo "a")"

    log_info "Detected partition layout:"
    log_info "  boot_a: ${boot_a_dev} (partition ${BOOT_A_PART})"
    log_info "  boot_b: ${boot_b_dev} (partition ${BOOT_B_PART})"
    log_info "  root_a: ${root_a_dev} (partition ${ROOT_A_PART})"
    log_info "  root_b: ${root_b_dev} (partition ${ROOT_B_PART})"
    log_info "Detected boot media for U-Boot: ${BOOT_DEVTYPE} ${BOOT_DEVNUM}"
    log_info "Detected current slot: ${CURRENT_SLOT}"
    log_info "Detected A/B boot mode: ${AB_BOOT_MODE}"
    log_info "Partition UUIDs:"
    log_info "  boot_a: ${boot_a_uuid:-<not found>}"
    log_info "  boot_b: ${boot_b_uuid:-<not found>}"
    log_info "  root_a: ${root_a_uuid:-<not found>}"
    log_info "  root_b: ${root_b_uuid:-<not found>}"
}

# Two fw_env.config entries = redundant env mode (torn-write safe); the
# write itself is fw_env_write_config from fwenv.sh (both flavors share it).
ensure_fw_env_config() {
    local boot_part_dev="$1" fw_env_device

    fw_env_device="$(fw_env_parent_disk "${boot_part_dev}")" || {
        log_error "Failed to detect U-Boot environment device"
        return 1
    }

    fw_env_write_config "${fw_env_device}" || {
        log_error "Failed to write ${OTA_FW_ENV_CONFIG}"
        return 1
    }
    log_info "Installed fw_env.config: ${fw_env_device} ${OTA_FW_ENV_OFFSET} + ${OTA_FW_ENV_REDUND_OFFSET} (redundant) ${OTA_FW_ENV_SIZE}"
}

configure_ab_boot_environment() {
    local init_slot

    ensure_fw_env_config "${boot_a_dev}" || return 1
    init_slot="$(ab_env_rebuild_slot "${CURRENT_SLOT}")"
    ab_env_initialize_default "${init_slot}" || return 1
    ab_env_repair_defaults "${init_slot}" || return 1
    ab_env_set \
        "distro_bootpart_a=${BOOT_A_PART}" \
        "distro_bootpart_b=${BOOT_B_PART}" \
        "ab_boot_devtype=${BOOT_DEVTYPE}" \
        "ab_boot_devnum=${BOOT_DEVNUM}" \
        "boot_targets=${BOOT_DEVTYPE}${BOOT_DEVNUM}" \
        "ab_boot_mode=${AB_BOOT_MODE}" || return 1
    log_info "Configured A/B boot environment"
}

mark_uboot_initialized() {
    mkdir -p "${AB_STATE_DIR}" || return 1
    cat > "${AB_UBOOT_INITIALIZED_FILE}" << EOF
# u-boot AB partition environment initialized
$(date)
boot_devtype=${BOOT_DEVTYPE}
boot_devnum=${BOOT_DEVNUM}
boot_mode=${AB_BOOT_MODE}
boot_a_part=${BOOT_A_PART}
boot_a_dev=${boot_a_dev}
boot_a_uuid=${boot_a_uuid}
root_a_part=${ROOT_A_PART}
root_a_dev=${root_a_dev}
root_a_uuid=${root_a_uuid}
boot_b_part=${BOOT_B_PART}
boot_b_dev=${boot_b_dev}
boot_b_uuid=${boot_b_uuid}
root_b_part=${ROOT_B_PART}
root_b_dev=${root_b_dev}
root_b_uuid=${root_b_uuid}
EOF
}

# Already initialized: healthy boots exit here; a dual-bad env re-runs
# full init via fw_setenv -f (state-aware: pending trial rolls back).
if [ "${1:-}" != "--force" ] && [ -f "${AB_UBOOT_INITIALIZED_FILE}" ]; then
    if ab_env_healthy; then
        exit 0
    fi
    log_error "persistent env unreadable; re-running full init (fw_setenv -f rebuild)"
fi

# Check if fw_setenv/fw_printenv exists
if ! command -v fw_printenv >/dev/null 2>&1 || ! command -v fw_setenv >/dev/null 2>&1; then
    fail "fw_printenv/fw_setenv not found"
fi

log_info "=== Initializing u-boot AB partition boot environment ==="
detect_ab_boot_partitions
detect_ab_root_partitions
detect_ab_boot_configuration
configure_ab_boot_environment
mark_uboot_initialized

log_info "=== u-boot AB environment initialization complete ==="
log_info "Please reboot for changes to take effect"
log_info "Current boot_slot: $(fw_printenv -n boot_slot)"
log_info "Current bootcmd: $(fw_printenv -n bootcmd)"

exit 0
