[Unit]
Description=Initialize u-boot environment for AB OTA
Documentation=file:///usr/share/armbian-ota
DefaultDependencies=no
After=local-fs.target
Before=armbian-ota-firstboot.service
Before=multi-user.target
# Every boot: healthy boots exit cheap, an unreadable env rebuilds via
# fw_setenv -f (the A/B twin of the Rescue reconciliation).

[Service]
Type=oneshot
ExecStart=/usr/lib/armbian/armbian-ota-init-uboot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
