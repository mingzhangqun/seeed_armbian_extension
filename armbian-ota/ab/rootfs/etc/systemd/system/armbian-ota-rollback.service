[Unit]
Description=Armbian AB OTA Rollback on Failure
Documentation=file:///usr/share/armbian-ota
DefaultDependencies=no
After=armbian-ota-firstboot.service
ConditionPathExists=/var/lib/armbian-ota/ota-state.env

[Service]
Type=oneshot
ExecCondition=/usr/bin/grep -qxF OTA_MODE=ab /var/lib/armbian-ota/ota-state.env
ExecCondition=/usr/bin/grep -Eq '^STATUS=(ready_to_boot|boot_verifying)$' /var/lib/armbian-ota/ota-state.env
ExecStart=/usr/sbin/armbian-ota rollback
TimeoutStartSec=60
StandardOutput=journal+console
StandardError=journal+console

# Never enabled directly: only started via the firstboot OnFailure trigger.
# The rollback command re-checks ota_in_progress and rolls the previous
# working slot back only when an OTA is in flight.

[Install]
