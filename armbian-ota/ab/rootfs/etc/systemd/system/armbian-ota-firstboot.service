[Unit]
Description=Armbian AB OTA First Boot Health Check
Documentation=file:///usr/share/armbian-ota
DefaultDependencies=no
After=local-fs.target armbian-ota-init-uboot.service
OnFailure=armbian-ota-rollback.service
ConditionPathExists=/var/lib/armbian-ota/ota-state.env

[Service]
Type=oneshot
ExecCondition=/usr/bin/grep -qxF OTA_MODE=ab /var/lib/armbian-ota/ota-state.env
ExecCondition=/usr/bin/grep -Eq '^STATUS=(ready_to_boot|boot_verifying)$' /var/lib/armbian-ota/ota-state.env
# U-Boot ota_in_progress=1 required: state and U-Boot must agree an OTA boot
# is pending, so a crashed state flip cannot false-mark success. An
# ExecCondition skip is not a failure (rollback not triggered).
ExecCondition=/bin/sh -c '[ "$(fw_printenv -n ota_in_progress 2>/dev/null || true)" = 1 ]'
ExecStart=/usr/lib/armbian/armbian-ota-health-check
ExecStartPost=/usr/sbin/armbian-ota mark-success
# On the rolled-back boot U-Boot cleared ota_in_progress and the third
# ExecCondition exits 1: systemd skips the start commands (verified:
# Result=success, OnFailure untriggered) and ExecStopPost is the only hook
# still run -- so reconcile lands there. Pass: no-op (mark-success done);
# failure: ota_in_progress still 1, defers to the rollback service.
ExecStopPost=/usr/sbin/armbian-ota reconcile
RemainAfterExit=yes
TimeoutStartSec=300
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
