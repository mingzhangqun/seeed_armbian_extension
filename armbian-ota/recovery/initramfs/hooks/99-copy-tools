#!/bin/sh

# initramfs-tools hook: add recovery OTA tools into initramfs

set -e

. /usr/share/initramfs-tools/hook-functions

echo "[99-copy-tools] adding OTA runtime tools into initramfs..." >&2

# Recovery persistence uses three directory-level overlayfs mounts before the
# real root is switched into place. Include the module for kernels where it is
# not built in.
manual_add_modules overlay

copy_exec_first() {
    dest="$1"
    shift

    for candidate in "$@"; do
        if [ -x "${candidate}" ]; then
            copy_exec "${candidate}" "${dest}"
            return 0
        fi
    done
    return 0
}
# NOTE: everything below feeds a `while read` loop over a heredoc -- the
# heredoc body is DATA, shell comments inside it would be parsed as a
# dest/candidates line. Keep commentary here, never inside the EOF block.

copy_ota_lib() {
    lib="$1"
    src="/usr/share/armbian-ota/${lib}"
    dest="${DESTDIR}/usr/share/armbian-ota/${lib}"

    [ -f "${src}" ] || {
        echo "[99-copy-tools] missing required OTA library: ${src}" >&2
        return 1
    }
    mkdir -p "$(dirname "${dest}")"
    cp -p "${src}" "${dest}"
}

copy_recovery_initramfs_lib() {
    lib="$1"
    src="/etc/initramfs-tools/ota/recovery/${lib}"
    dest="${DESTDIR}/usr/share/armbian-ota/recovery/${lib}"

    [ -f "${src}" ] || {
        echo "[99-copy-tools] missing required recovery initramfs library: ${src}" >&2
        return 1
    }
    mkdir -p "$(dirname "${dest}")"
    cp -p "${src}" "${dest}"
}

# initramfs-tools' copy_file() is a no-op when the destination already
# exists, and by the time this hook runs the busybox hook has already
# hard-linked every applet into usr/bin -- plain copy_exec therefore keeps
# the busybox applet silently. Drop the busybox hardlinks for the tools the
# OTA apply path depends on (GNU tar for -J, gzip, and the real xz so
# payload decode is threaded instead of the single-threaded busybox applet)
# and let the copy list below install the real binaries in their place.
# Same pattern as the mke2fs fix further down. dd must be on this list too:
# busybox dd has no conv=fsync, so the raw boot.itb write bailed out in 2ms
# with "invalid conv" (observed on the rk3588 encrypted recovery OTA).
for bb_applet in tar gzip gunzip xz sha256sum dd; do
    rm -f "${DESTDIR}/usr/bin/${bb_applet}" "${DESTDIR}/bin/${bb_applet}"
done

while read -r dest candidates; do
    [ -n "${dest}" ] || continue
    copy_exec_first "${dest}" ${candidates}
done <<'EOF'
/usr/bin /usr/bin/rm /bin/rm
/usr/bin /usr/bin/cp /bin/cp
/usr/bin /usr/bin/tar /bin/tar
/usr/bin /usr/bin/gzip /bin/gzip
/usr/bin /usr/bin/gunzip /bin/gunzip
/usr/bin /usr/bin/xz /bin/xz
/usr/bin /usr/bin/zstd /bin/zstd
/usr/bin /usr/bin/sed /bin/sed
/usr/bin /usr/bin/find /bin/find
/usr/bin /usr/bin/grep /bin/grep
/usr/bin /usr/bin/head /bin/head
/usr/bin /usr/bin/cat /bin/cat
/usr/bin /usr/bin/basename /bin/basename
/usr/bin /usr/bin/tail /bin/tail
/usr/bin /usr/bin/date /bin/date
/usr/bin /usr/bin/sync /bin/sync
/usr/bin /usr/bin/sha256sum /bin/sha256sum
/usr/bin /usr/bin/awk /bin/awk
/usr/bin /usr/bin/wc /bin/wc
/usr/bin /usr/bin/od /bin/od
/usr/bin /usr/bin/tr /bin/tr
/usr/bin /usr/bin/dd /bin/dd
/usr/bin /usr/bin/mount /bin/mount
/usr/bin /usr/bin/umount /bin/umount
/usr/bin /usr/bin/mountpoint /bin/mountpoint
/usr/sbin /usr/sbin/mkfs.ext4 /usr/sbin/mke2fs /sbin/mkfs.ext4 /sbin/mke2fs
/usr/sbin /usr/sbin/blkid /sbin/blkid
/usr/bin /usr/bin/udevadm /bin/udevadm
/usr/bin /usr/bin/sleep /bin/sleep
/usr/sbin /usr/sbin/reboot /sbin/reboot
EOF

# fw_setenv/fw_printenv: stage explicitly (binaries + the private
# libubootenv.so.0) instead of copy_exec -- copy_exec resolves dependencies
# through ldd and silently dropped these two on the build host (observed:
# every other binary stages fine, fw_* vanish without an error).
fw_env_staged=0
for fw_bin in fw_setenv fw_printenv; do
    for pfx in /usr/bin /usr/sbin /sbin; do
        if [ -x "${pfx}/${fw_bin}" ]; then
            mkdir -p "${DESTDIR}${pfx}"
            cp -p "${pfx}/${fw_bin}" "${DESTDIR}${pfx}/${fw_bin}"
            fw_env_staged=$((fw_env_staged + 1))
            break
        fi
    done
done
if [ "${fw_env_staged}" -eq 2 ]; then
    for lib in /usr/lib/aarch64-linux-gnu/libubootenv.so.0* \
               /lib/aarch64-linux-gnu/libubootenv.so.0*; do
        [ -e "${lib}" ] || continue
        mkdir -p "${DESTDIR}/usr/lib/aarch64-linux-gnu"
        cp -p "${lib}" "${DESTDIR}/usr/lib/aarch64-linux-gnu/"
    done
    echo "[99-copy-tools] staged fw_setenv/fw_printenv + libubootenv" >&2
else
    echo "[99-copy-tools] WARN: fw_setenv/fw_printenv not found in rootfs (${fw_env_staged}/2); OTA env writes will fail on device" >&2
fi

# e2fsprogs ships mkfs.ext4 as a symlink to mke2fs. The initramfs busybox
# already installs its own mke2fs applet hardlink at that path, and busybox
# has no "mkfs.ext4" applet name, so the copied symlink dispatches into
# busybox and dies with "applet not found" at OTA time (observed on the
# rk3572 recovery initramfs). Drop the busybox hardlink and copy the real
# mke2fs binary in its place; copy_exec brings its shared libraries too.
rm -f "${DESTDIR}/usr/sbin/mke2fs" "${DESTDIR}/sbin/mke2fs"
copy_exec_first /usr/sbin /usr/sbin/mke2fs /sbin/mke2fs

copy_ota_lib state.sh
copy_ota_lib find-userdata.sh
copy_ota_lib fwenv.sh
copy_recovery_initramfs_lib log.sh
copy_recovery_initramfs_lib device.sh
copy_recovery_initramfs_lib payload.sh

# Without this mke2fs falls back to compiled-in defaults; ship the config.
if [ -f /etc/mke2fs.conf ]; then
    mkdir -p "${DESTDIR}/etc"
    cp -p /etc/mke2fs.conf "${DESTDIR}/etc/mke2fs.conf"
fi

# readlink is used by find-userdata.sh to walk sysfs parent links.
copy_exec /usr/bin/readlink /usr/bin 2>/dev/null || \
copy_exec /bin/readlink /bin 2>/dev/null || true
