From 623b01bf95310dc3c40b7608c16fdd5cb365e610 Mon Sep 17 00:00:00 2001
From: mingzq <north_sea@qq.com>
Date: Mon, 16 Nov 2026 06:14:56 +0000
Subject: [PATCH] media: rockchip: camera fixes for recomputer devkits (imx219
 power + VCM)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Squash of the fix/imx708_imx219 branch (fe9944f8..67bb8b01) for the
recomputer-rk3576 camera path:

- imx219: control VANA power on RK3576 CSI0/CSI1 (da28a0c) — vana-supply
  toggled with XVCLK in s_power(), control defaults cached while the
  sensor is unpowered, cam0_pwr/cam1_pwr turned into controlled
  regulators with POR delays
- dts: fix VCM supply and unify camera power logic on recomputer
  devkits (1a0ab3b1) — imx708/imx219 probing no longer races the
  dw9800w-vcc power state
- media: i2c: dw9800w: accept any readable chip id (80044c82) —
  production modules carry chip-id variants
- dts: tune VCM currents on recomputer devkit cameras (c2695889)
- media: i2c: imx219: harden unpowered control and stream-stop paths
  (67bb8b01) — no I2C while VANA off; s_stream(0) stays safe when the
  sensor was never powered on
---
 .../recomputer-rk3588-devkit-cam1-rpi-v3.dts  |  5 +-
 .../recomputer-rk3576-devkit-cam.dtsi         | 31 ++++----
 .../recomputer-rk3588-devkit-cam.dtsi         | 28 ++++---
 drivers/media/i2c/dw9800w.c                   | 13 ++--
 drivers/media/i2c/imx219.c                    | 78 +++++++++++++++++--
 5 files changed, 112 insertions(+), 43 deletions(-)

diff --git a/arch/arm64/boot/dts/rockchip/overlay/recomputer-rk3588-devkit-cam1-rpi-v3.dts b/arch/arm64/boot/dts/rockchip/overlay/recomputer-rk3588-devkit-cam1-rpi-v3.dts
index 4d2413d1bc3d..dda0482378af 100644
--- a/arch/arm64/boot/dts/rockchip/overlay/recomputer-rk3588-devkit-cam1-rpi-v3.dts
+++ b/arch/arm64/boot/dts/rockchip/overlay/recomputer-rk3588-devkit-cam1-rpi-v3.dts
@@ -37,10 +37,7 @@ fragment@4 {
 
 	fragment@5 {
 		target = <&dw9817_1>;
-		__overlay__ {
-			status = "okay";
-			VDD-supply = <&cam1_rst>;
-		};
+		__overlay__ { status = "okay"; };
 	};
 
 	fragment@6 {
diff --git a/arch/arm64/boot/dts/rockchip/recomputer-rk3576-devkit-cam.dtsi b/arch/arm64/boot/dts/rockchip/recomputer-rk3576-devkit-cam.dtsi
index 44bbb8f52067..5342be6ca977 100644
--- a/arch/arm64/boot/dts/rockchip/recomputer-rk3576-devkit-cam.dtsi
+++ b/arch/arm64/boot/dts/rockchip/recomputer-rk3576-devkit-cam.dtsi
@@ -5,7 +5,6 @@
  */
 
 / {
-
     cam0_pwr: cam0-pwr {
         status = "disabled";
         compatible = "regulator-fixed";
@@ -13,9 +12,9 @@ cam0_pwr: cam0-pwr {
         regulator-min-microvolt = <3300000>;
         regulator-max-microvolt = <3300000>;
         enable-active-high;
-        gpio = <&gpio_xten  0  GPIO_ACTIVE_HIGH>; 
-        regulator-boot-on;         
-        regulator-always-on;        
+        gpio = <&gpio_xten  0  GPIO_ACTIVE_HIGH>;
+        startup-delay-us = <100000>;
+        off-on-delay-us = <500000>;
     };
 
     cam1_pwr: cam1-pwr {
@@ -25,11 +24,10 @@ cam1_pwr: cam1-pwr {
         regulator-min-microvolt = <3300000>;
         regulator-max-microvolt = <3300000>;
         enable-active-high;
-        gpio = <&gpio1  RK_PD1  GPIO_ACTIVE_HIGH>; 
-        regulator-boot-on;         
-        regulator-always-on;        
+        gpio = <&gpio1  RK_PD1  GPIO_ACTIVE_HIGH>;
+        startup-delay-us = <100000>;
+        off-on-delay-us = <500000>;
     };
-    
 
 	cam0_rst: cam0-rst {
 		compatible = "regulator-fixed";
@@ -91,7 +89,7 @@ imx219_0: imx219@10 {
         port {
             imx219_out0: endpoint {
                 remote-endpoint = <&mipi_in_ucam2>;
-                data-lanes = <1 2>;					
+                data-lanes = <1 2>;
             };
         };
     };
@@ -101,14 +99,13 @@ dw9817_0: dw9817@c {
 		compatible = "dongwoon,dw9800w";
 		status = "disabled";
 		reg = <0x0c>;
-		VDD-supply = <&cam0_rst>;
-		power-supply = <&cam0_pwr>;
+		avdd-supply = <&cam0_pwr>;
 		rockchip,camera-module-index = <0>;
-		rockchip,vcm-start-current = <10>;
+		rockchip,vcm-start-current = <37>;
+		rockchip,vcm-max-current = <85>;
 		rockchip,vcm-rated-current = <85>;
 		rockchip,vcm-step-mode = <5>;
 		rockchip,camera-module-facing = "back";
-
 	};
 
 	imx708_0: imx708@1a {
@@ -156,7 +153,7 @@ imx219_1: imx219@10 {
         port {
             imx219_out1: endpoint {
                 remote-endpoint = <&mipi_in_ucam3>;
-                data-lanes = <1 2>;					
+                data-lanes = <1 2>;
             };
         };
     };
@@ -166,10 +163,10 @@ dw9817_1: dw9817@c {
 		compatible = "dongwoon,dw9800w";
 		status = "disabled";
 		reg = <0x0c>;
-		VDD-supply = <&cam1_rst>;
-		power-supply = <&cam1_pwr>;
+		avdd-supply = <&cam1_pwr>;
 		rockchip,camera-module-index = <1>;
-		rockchip,vcm-start-current = <10>;
+		rockchip,vcm-start-current = <37>;
+		rockchip,vcm-max-current = <85>;
 		rockchip,vcm-rated-current = <85>;
 		rockchip,vcm-step-mode = <5>;
 		rockchip,camera-module-facing = "back";
diff --git a/arch/arm64/boot/dts/rockchip/recomputer-rk3588-devkit-cam.dtsi b/arch/arm64/boot/dts/rockchip/recomputer-rk3588-devkit-cam.dtsi
index 2d2d160ed3b5..12413b63f3cd 100644
--- a/arch/arm64/boot/dts/rockchip/recomputer-rk3588-devkit-cam.dtsi
+++ b/arch/arm64/boot/dts/rockchip/recomputer-rk3588-devkit-cam.dtsi
@@ -12,7 +12,7 @@ cam0_rst: cam0-rst {
 		regulator-min-microvolt = <3300000>;
 		regulator-max-microvolt = <3300000>;
 		enable-active-high;
-		gpio = <&gpio3 RK_PB4 GPIO_ACTIVE_HIGH>;
+		gpio = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
 		regulator-boot-on;
 		regulator-always-on;
 	};
@@ -23,31 +23,33 @@ cam1_rst: cam1-rst {
 		regulator-min-microvolt = <3300000>;
 		regulator-max-microvolt = <3300000>;
 		enable-active-high;
-		gpio = <&gpio0 RK_PB7 GPIO_ACTIVE_HIGH>;
+		gpio = <&gpio3 RK_PB4 GPIO_ACTIVE_HIGH>;
 		regulator-boot-on;
 		regulator-always-on;
 	};
 
 	cam0_pwr: cam0-pwr {
+		status = "disabled";
 		compatible = "regulator-fixed";
 		regulator-name = "cam0_pwr";
 		regulator-min-microvolt = <3300000>;
 		regulator-max-microvolt = <3300000>;
 		enable-active-high;
 		gpio = <&gpio2 RK_PB6 GPIO_ACTIVE_HIGH>;
-		regulator-boot-on;
-		regulator-always-on;
+		startup-delay-us = <100000>;
+		off-on-delay-us = <500000>;
 	};
 
 	cam1_pwr: cam1-pwr {
+		status = "disabled";
 		compatible = "regulator-fixed";
 		regulator-name = "cam1_pwr";
 		regulator-min-microvolt = <3300000>;
 		regulator-max-microvolt = <3300000>;
 		enable-active-high;
 		gpio = <&gpio3 RK_PB0 GPIO_ACTIVE_HIGH>;
-		regulator-boot-on;
-		regulator-always-on;
+		startup-delay-us = <100000>;
+		off-on-delay-us = <500000>;
 	};
 
 	/* Camera clocks */
@@ -94,12 +96,13 @@ imx219_out0: endpoint {
 
 	/* Raspberry Pi Camera v3 (IMX708 + VCM) */
 	dw9817_0: dw9817@c {
-		compatible = "dongwoon,dw9817-vcm";
+		compatible = "dongwoon,dw9800w";
 		status = "disabled";
 		reg = <0x0c>;
-		VDD-supply = <&cam0_rst>;
+		avdd-supply = <&cam0_pwr>;
 		rockchip,camera-module-index = <0>;
-		rockchip,vcm-start-current = <10>;
+		rockchip,vcm-start-current = <37>;
+		rockchip,vcm-max-current = <85>;
 		rockchip,vcm-rated-current = <85>;
 		rockchip,vcm-step-mode = <5>;
 		rockchip,camera-module-facing = "front";
@@ -155,12 +158,13 @@ imx219_out1: endpoint {
 
 	/* Raspberry Pi Camera v3 (IMX708 + VCM) */
 	dw9817_1: dw9817@c {
-		compatible = "dongwoon,dw9817-vcm";
+		compatible = "dongwoon,dw9800w";
 		status = "disabled";
 		reg = <0x0c>;
-		VDD-supply = <&cam1_rst>;
+		avdd-supply = <&cam1_pwr>;
 		rockchip,camera-module-index = <1>;
-		rockchip,vcm-start-current = <10>;
+		rockchip,vcm-start-current = <37>;
+		rockchip,vcm-max-current = <85>;
 		rockchip,vcm-rated-current = <85>;
 		rockchip,vcm-step-mode = <5>;
 		rockchip,camera-module-facing = "back";
diff --git a/drivers/media/i2c/dw9800w.c b/drivers/media/i2c/dw9800w.c
index ce534c9631f4..c504e5b682db 100644
--- a/drivers/media/i2c/dw9800w.c
+++ b/drivers/media/i2c/dw9800w.c
@@ -597,13 +597,16 @@ static int dw9800w_check_id(struct dw9800w_device *dw9800w_dev)
 	__dw9800w_set_power(dw9800w_dev, true);
 	ret = dw9800w_read_reg(client, DW9800W_REG_CHIP_ID, 1, &pid);
 
-	if (pid != DW9800W_CHIP_ID) {
-		dev_err(dev, "Unexpected sensor id(%06x), ret(%d)\n", pid, ret);
-		return -ENODEV;
+	if (ret) {
+		dev_err(dev, "read chip id failed(%d)\n", ret);
+		return ret;
 	}
 
-	dev_info(&dw9800w_dev->client->dev,
-		 "Detected dw9800w vcm id:0x%x\n", DW9800W_CHIP_ID);
+	if (pid != DW9800W_CHIP_ID)
+		dev_warn(dev, "chip id 0x%02x != expected 0x%02x, continuing\n",
+			 pid, DW9800W_CHIP_ID);
+
+	dev_info(dev, "Detected dw9800w vcm id:0x%x\n", pid);
 	return 0;
 }
 static int dw9800w_probe_init(struct i2c_client *client)
diff --git a/drivers/media/i2c/imx219.c b/drivers/media/i2c/imx219.c
index a59f301c6533..f49d1270c52b 100644
--- a/drivers/media/i2c/imx219.c
+++ b/drivers/media/i2c/imx219.c
@@ -10,6 +10,7 @@
  */
 #include <linux/clk.h>
 #include <linux/delay.h>
+#include <linux/regulator/consumer.h>
 #include <linux/i2c.h>
 #include <linux/init.h>
 #include <linux/io.h>
@@ -224,6 +225,8 @@ struct imx219 {
 	struct media_pad pad;
 	struct v4l2_ctrl_handler ctrl_handler;
 	struct clk *clk;
+	struct regulator *vana;
+	bool powered;
 	struct v4l2_rect crop_rect;
 	int hflip;
 	int vflip;
@@ -348,8 +351,11 @@ static int imx219_s_stream(struct v4l2_subdev *sd, int enable)
 	u8 reg = 0x00;
 	int ret;
 
-	if (!enable)
+	if (!enable) {
+		if (!priv->powered)
+			return 0;
 		return reg_write_table(client, stop);
+	}
 
 	ret = reg_write_table(client, priv->cur_mode->reg_list);
 	if (ret)
@@ -419,6 +425,20 @@ static int imx219_s_stream(struct v4l2_subdev *sd, int enable)
 	if (ret)
 		return ret;
 
+	/*
+	 * Replay the cached exposure and gain registers: the mode table does
+	 * not program them, and they may have been accepted while the sensor
+	 * was unpowered.  HFLIP/VFLIP, test pattern and crop are replayed by
+	 * the mode setup above; VBLANK is fixed per mode (read-only ctrl).
+	 */
+	ret = reg_write(client, 0x0157, priv->analogue_gain);
+	ret |= reg_write(client, 0x0158, priv->digital_gain >> 8);
+	ret |= reg_write(client, 0x0159, priv->digital_gain & 0xff);
+	ret |= reg_write(client, 0x015a, priv->exposure_time >> 8);
+	ret |= reg_write(client, 0x015b, priv->exposure_time & 0xff);
+	if (ret)
+		return ret;
+
 	return reg_write_table(client, start);
 }
 
@@ -427,13 +447,32 @@ static int imx219_s_power(struct v4l2_subdev *sd, int on)
 {
 	struct i2c_client *client = v4l2_get_subdevdata(sd);
 	struct imx219 *priv = to_imx219(client);
+	int ret;
 
-	if (on)	{
+	if (on) {
 		dev_dbg(&client->dev, "imx219 power on\n");
-		clk_prepare_enable(priv->clk);
-	} else if (!on) {
+
+		ret = regulator_enable(priv->vana);
+		if (ret) {
+			dev_err(&client->dev, "failed to enable vana: %d\n", ret);
+			return ret;
+		}
+
+		ret = clk_prepare_enable(priv->clk);
+		if (ret) {
+			dev_err(&client->dev, "failed to enable clock: %d\n", ret);
+			regulator_disable(priv->vana);
+			return ret;
+		}
+
+		/* IMX219 needs t4 + max(t5, t6) after power and clock are up. */
+		usleep_range(6200, 7200);
+		priv->powered = true;
+	} else {
 		dev_dbg(&client->dev, "imx219 power off\n");
+		priv->powered = false;
 		clk_disable_unprepare(priv->clk);
+		regulator_disable(priv->vana);
 	}
 
 	return 0;
@@ -538,6 +577,13 @@ static int imx219_s_ctrl(struct v4l2_ctrl *ctrl)
 	u16 a_gain = 256;
 	u16 d_gain = 1;
 
+	/*
+	 * Control defaults are initialized before imx219_video_probe() powers
+	 * the sensor, and userspace may queue settings before streaming.
+	 * Always cache the values in priv; only the register access below is
+	 * skipped while the sensor is unpowered. imx219_s_stream() replays
+	 * the cached exposure and gain registers at stream start.
+	 */
 	switch (ctrl->id) {
 	case V4L2_CID_HFLIP:
 		priv->hflip = ctrl->val;
@@ -595,6 +641,9 @@ static int imx219_s_ctrl(struct v4l2_ctrl *ctrl)
 		 * so the exposure & gain can reflect at the same frame
 		 */
 
+		if (!priv->powered)
+			return 0;
+
 		ret = reg_write(client, 0x0157, priv->analogue_gain);
 		ret |= reg_write(client, 0x0158, priv->digital_gain >> 8);
 		ret |= reg_write(client, 0x0159, priv->digital_gain & 0xff);
@@ -604,6 +653,9 @@ static int imx219_s_ctrl(struct v4l2_ctrl *ctrl)
 	case V4L2_CID_EXPOSURE:
 		priv->exposure_time = ctrl->val;
 
+		if (!priv->powered)
+			return 0;
+
 		ret = reg_write(client, 0x015a, priv->exposure_time >> 8);
 		ret |= reg_write(client, 0x015b, priv->exposure_time & 0xff);
 		return ret;
@@ -616,6 +668,10 @@ static int imx219_s_ctrl(struct v4l2_ctrl *ctrl)
 			ctrl->val = priv->cur_mode->vts_def;
 		if ((ctrl->val - IMX219_EXP_LINES_MARGIN) != priv->cur_vts)
 			priv->cur_vts = ctrl->val - IMX219_EXP_LINES_MARGIN;
+
+		if (!priv->powered)
+			return 0;
+
 		ret = reg_write(client, 0x0160, ((priv->cur_vts >> 8) & 0xff));
 		ret |= reg_write(client, 0x0161, (priv->cur_vts & 0xff));
 		return ret;
@@ -623,8 +679,13 @@ static int imx219_s_ctrl(struct v4l2_ctrl *ctrl)
 	default:
 		return -EINVAL;
 	}
-	/* If enabled, apply settings immediately */
+	/* If enabled, apply settings immediately; else s_stream() will */
+	if (!priv->powered)
+		return 0;
+
 	reg = reg_read(client, 0x0100);
+	if (reg < 0)
+		return reg;
 	if ((reg & 0x1f) == 0x01)
 		imx219_s_stream(&priv->subdev, 1);
 
@@ -1062,6 +1123,13 @@ static int imx219_probe(struct i2c_client *client,
 		return -EPROBE_DEFER;
 	}
 
+	/* Each CSI instance controls its own vana-supply (cam0_pwr/cam1_pwr). */
+	priv->vana = devm_regulator_get(&client->dev, "vana");
+	if (IS_ERR(priv->vana)) {
+		dev_err(&client->dev, "failed to get vana supply\n");
+		return PTR_ERR(priv->vana);
+	}
+
 	/* 1920 * 1080 by default */
 	priv->cur_mode = &supported_modes[1];
 	priv->cfg_num = ARRAY_SIZE(supported_modes);
-- 
2.55.0

