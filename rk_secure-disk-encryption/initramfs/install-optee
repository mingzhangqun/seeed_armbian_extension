#!/bin/sh

# initramfs-tools hook: stage OP-TEE client (tee-supplicant, libteec) and
# the keybox TA into the initramfs.

set -e

PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac


. /usr/share/initramfs-tools/hook-functions

echo "[install-optee] adding optee client and ta into initramfs..." >&2

copy_exec /usr/bin/keybox_app
copy_exec /lib/optee_armtz/8c6cf810-685d-4654-ae71-8031beee467e.ta
copy_exec /usr/bin/tee-supplicant

# copy_exec takes a single source on modern initramfs-tools; a glob would
# expand into (src, target, ...) argument slots.
for lib in /usr/lib/libteec.so /usr/lib/libteec.so.1 /usr/lib/libteec.so.1.0 /usr/lib/libteec.so.1.0.0; do
    copy_exec "${lib}"
done
